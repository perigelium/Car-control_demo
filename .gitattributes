# Set the default behavior to automatically handle line endings
* text=auto

# Explicitly force LF (Linux/Mac) line endings for code and text files
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Force LF line endings for shell scripts to prevent execution errors on Linux/Mac
*.sh text eol=lf
gradlew text eol=lf

# Explicitly treat binary files as binary (do not modify line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.jar binary
*.aar binary
